# 이 프로젝트를 로컬에서 실행하려면, 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# .env 자체는 .gitignore에 포함되어 있어 커밋되지 않습니다. 이 .env.example 파일은
# 어떤 값이 필요한지 보여주는 용도라, 실제 비밀값을 넣지 않은 채로 커밋해도 됩니다.

# 세션 쿠키 서명에 쓰는 비밀값. 배포 전 무작위 문자열로 반드시 바꾸세요.
# (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-to-a-random-string

# Supabase 프로젝트 설정 (Supabase 대시보드 → Project Settings → API에서 확인)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 반드시 "service_role" 키를 쓰세요. anon/publishable 키와는 다른 키입니다.
# 이 키는 RLS를 우회하므로 서버에서만 쓰고, 절대 프론트엔드나 커밋되는 파일에 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# 배포된 실제 도메인에 맞게 설정하세요 (로컬 개발 중에는 비워두면 localhost로 동작합니다).
# 예: WEBAUTHN_RP_ID=your-project.vercel.app
#     WEBAUTHN_ORIGIN=https://your-project.vercel.app
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# 배포 환경에서는 반드시 production으로 설정하세요 (세션 쿠키의 Secure 플래그가 여기에 따라 켜집니다).
NODE_ENV=development
