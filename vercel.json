{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "Intro.html",
          "Paper.html",
          "FactorFinder.html",
          "ff-favicon-32.png",
          "ff-favicon-48.png",
          "ff-apple-touch-icon.png",
          "ff-og.jpg",
          "ritual_scatter.png",
          "Plan_page.html",
          "Preference_page.html",
          "Strength_page.html",
          "Haengro.png",
          "Sec_Gui.pen",
          "supabase-client.js",
          "minigame/**",
          "Weather/**",
          "PDS/**",
          "studio/**",
          "project/**",
          "slime_project/**",
          "spell_project/**",
          "contracts/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.js" }]
}
