# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채우세요.
# .env 파일은 절대 다른 사람과 공유하거나 GitHub에 올리지 마세요.

# 어떤 AI를 쓸지: gemini (인터넷, 무료 한도 있음) 또는 ollama (내 컴퓨터, 한도 없음)
LLM_PROVIDER=gemini

# ---------- Gemini ----------
GEMINI_API_KEY=여기에_API_키
# 무료 티어 모델. 혼잡(503)이 계속되면 다른 모델로 바꿔보세요.
#   gemini-3.5-flash / gemini-3.6-flash / gemini-3.7-flash / gemini-3.5-flash-lite
# 한 번의 실험 묶음(샘플 10개 비교 등) 안에서는 모델을 바꾸지 마세요. 결과를 비교할 수 없게 됩니다.
GEMINI_MODEL=gemini-3.5-flash
# 호출 사이 최소 간격(초). 429(호출 한도 초과)가 자주 나면 늘리세요.
GEMINI_MIN_INTERVAL=5
# 한 번 실행에서 보낼 요청 수 상한 (재시도 포함). V1 9번 + 단일 비교 2번 + 여유 3번
GEMINI_MAX_REQUESTS=14
# 서버 혼잡(503 등)일 때 한 단계에서 다시 시도하는 횟수
GEMINI_BUSY_RETRIES=2

# ---------- Ollama (로컬) ----------
# 터미널에서 `ollama list`로 나오는 이름을 그대로 적으세요.
OLLAMA_MODEL=
# 보통은 바꿀 필요 없음
OLLAMA_HOST=http://localhost:11434
# 한 번에 읽을 수 있는 글 길이. 프롬프트가 길어서 넉넉히 잡음. 그래픽카드 메모리가 부족하면 8192로 줄이세요.
OLLAMA_NUM_CTX=16384
# 한 번 호출을 기다리는 최대 시간(초). 느린 컴퓨터면 늘리세요.
OLLAMA_TIMEOUT=900

# ---------- 공통 ----------
# 동시에 보낼 호출 수. 무료 티어와 로컬 AI 모두 1(차례대로)을 권장합니다.
CORTEX_PARALLEL=1
