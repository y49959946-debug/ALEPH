# 이 파일을 복사해서 이름을 .env 로 바꾸고, 키를 넣으세요.
# .env 파일은 절대 다른 사람과 공유하거나 GitHub에 올리지 마세요.
GEMINI_API_KEY=여기에_API_키

# 사용할 무료 티어 모델. 혼잡(503)이 계속되면 다른 모델로 바꿔보세요.
#   gemini-3.5-flash / gemini-3.6-flash / gemini-3.7-flash / gemini-3.5-flash-lite
# 한 번의 실험 묶음(샘플 10개 비교 등) 안에서는 모델을 바꾸지 마세요. 결과를 비교할 수 없게 됩니다.
GEMINI_MODEL=gemini-3.5-flash

# 호출 사이 최소 간격(초). 429(호출 한도 초과)가 자주 나면 늘리세요.
GEMINI_MIN_INTERVAL=5

# 동시에 보낼 호출 수. 무료 티어는 1(차례대로)을 권장합니다.
CORTEX_PARALLEL=1
